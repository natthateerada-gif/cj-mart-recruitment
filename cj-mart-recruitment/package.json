{
  "name": "cj-mart-recruitment",
  "version": "1.0.0",
  "description": "CJ Mart careers site + recruitment database (Node.js + Express + PostgreSQL). Designed for future integration with CJ Mart's Recruitment Management System via REST API and webhook.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node db/migrate.js",
    "hash-password": "node scripts/hash-password.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18"
  }
}
