# Copy to .env (local / docker-compose) or set these in your hosting platform.
# NEVER commit the real .env file.

# ---------------------------------------------------------------- required
# Postgres connection string: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# (URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL=postgresql://cjmart:change-me@localhost:5432/cjmart

# Long random string used to sign admin session cookies (>= 32 chars).
#   generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin panel password. Prefer the bcrypt hash (generate with: npm run hash-password)
# so the plain password is never stored. ADMIN_PASSWORD is only a fallback.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# ---------------------------------------------------------------- server
PORT=3000
NODE_ENV=production

# Number of reverse proxies in front of the app (nginx / load balancer) = 1 in most
# setups. Needed so the admin login limiter sees the real client IP.
TRUST_PROXY=

# Session cookie is HTTPS-only in production. If the site is served over plain HTTP
# inside a private network, set false (otherwise admin login will not stick).
COOKIE_SECURE=

# Only needed if the frontend is served from a DIFFERENT origin. Comma separated.
CORS_ORIGINS=

# ---------------------------------------------------------------- database
# true (default): TLS, certificate not verified | verify: TLS + verify certificate
# false: no TLS (Postgres on the same private network)
PGSSL=false
# PGSSL_CA_FILE=/run/secrets/db-ca.pem     # only with PGSSL=verify and a private CA
# PG_POOL_MAX=10

# Load demo jobs + placeholder HR contacts on migrate. Keep 0 in production.
SEED_SAMPLE_DATA=0

# ---------------------------------------------------------------- admin login limiter
# LOGIN_MAX_FAILURES=10
# LOGIN_WINDOW_MINUTES=15

# ---------------------------------------------------------------- RMS integration (optional)
# Key the RMS must send in the X-API-Key header to read data via /api/integration/*
INTEGRATION_API_KEY=
# If set, every new application is POSTed here as JSON (5s timeout, never blocks applicants)
RMS_WEBHOOK_URL=
